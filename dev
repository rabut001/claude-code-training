#!/usr/bin/env bash
# 開発用コマンド。Python や PDF の処理、開発サーバーを Docker コンテナの中で動かす。
# 使い方: ./dev help
set -euo pipefail

cd "$(dirname "$0")"
export HOST_UID="${HOST_UID:-$(id -u)}"
export HOST_GID="${HOST_GID:-$(id -g)}"

usage() {
  cat <<'EOF'
使い方: ./dev <コマンド> [引数...]

  check              テスト → 検証 → ビルド（CI と同じ。コミット前に実行する）
  test               validate.py / build.py のテスト
  validate [引数]    データを検証する（例: ./dev validate --strict-counts）
  build [引数]       app/data/ を生成する（例: ./dev build --questions tests/fixtures/questions）
  serve              開発サーバーを起動する（http://localhost:8000、止めるときは Ctrl+C）
  pdf <PDF> [出力]   PDF をテキストにする（出力を省略すると画面に表示）
  py <引数...>       コンテナの python3 を実行する（例: ./dev py tools/import_bajor.py）
  run <コマンド...>  コンテナで任意のコマンドを実行する
  shell              コンテナのシェルに入る
  image              コンテナのイメージを作り直す

PDF などのファイルは、リポジトリの中（例: .cache/）に置いてください。コンテナからはリポジトリしか見えません。
EOF
}

# 端末から実行したときだけ TTY を割り当てる（AI やパイプから実行したときは -T）
tty_flag=()
if [[ ! -t 0 || ! -t 1 ]]; then tty_flag=(-T); fi

run() { docker compose run --rm "${tty_flag[@]}" dev "$@"; }

cmd="${1:-help}"
shift || true

case "$cmd" in
  check)
    run sh -c 'python3 -m unittest discover -s tests && python3 tools/validate.py && python3 tools/build.py' ;;
  test)
    run python3 -m unittest discover -s tests "$@" ;;
  validate)
    run python3 tools/validate.py "$@" ;;
  build)
    run python3 tools/build.py "$@" ;;
  serve)
    echo "http://localhost:${WEB_PORT:-8000} で開けます（止めるときは Ctrl+C）"
    docker compose up web ;;
  pdf)
    [[ $# -ge 1 ]] || { echo "PDF のパスを指定してください" >&2; exit 2; }
    run pdftotext -layout "$1" "${2:--}" ;;
  py)
    run python3 "$@" ;;
  run)
    [[ $# -ge 1 ]] || { echo "実行するコマンドを指定してください" >&2; exit 2; }
    run "$@" ;;
  shell)
    docker compose run --rm dev bash ;;
  image)
    docker compose build dev ;;
  help|-h|--help)
    usage ;;
  *)
    echo "不明なコマンド: $cmd" >&2
    usage >&2
    exit 2 ;;
esac
