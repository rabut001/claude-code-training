{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/exam.schema.json",
  "title": "Exam (schema 1)",
  "description": "試験の情報。説明は docs/data-format.md、検証の正本は tools/validate.py。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "code", "name", "exam", "domains", "sources"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "enum": ["ccdv-f", "ccar-p"] },
    "code": { "type": "string", "minLength": 1 },
    "name": { "$ref": "#/$defs/i18n" },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions", "minutes", "pass_scaled", "scale_min", "scale_max", "pass_raw_estimate"],
      "properties": {
        "questions": { "type": "integer", "minimum": 1 },
        "minutes": { "type": "integer", "minimum": 1 },
        "pass_scaled": { "type": "integer" },
        "scale_min": { "type": "integer" },
        "scale_max": { "type": "integer" },
        "pass_raw_estimate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "weight", "mock_items"],
        "properties": {
          "id": { "type": "string", "pattern": "^d[0-9]+$" },
          "name": { "$ref": "#/$defs/i18n" },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "mock_items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["abbr", "repo", "commit", "license", "questions"],
        "properties": {
          "abbr": { "type": "string", "pattern": "^[a-z]{2}$" },
          "repo": { "type": "string" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "license": { "const": "MIT" },
          "questions": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ja"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "ja": { "type": "string", "minLength": 1 } }
    }
  }
}
